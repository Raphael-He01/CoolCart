# Copy to .env.local for Vite development, or set it as a server variable in Vercel.
# Keep the key out of the browser and the public Git repository.
DEEPSEEK_API_KEY=

# Server-only quota store for the two hosted API routes. Not needed by local Vite.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
COOLCART_AI_HOURLY_LIMIT=200
COOLCART_AI_PER_IP_HOURLY_LIMIT=30
